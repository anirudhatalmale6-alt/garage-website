# Photos only. If anything ever manages to drop a script in here,
# this stops the server from running it.
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|cgi|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
php_flag engine off
Options -Indexes
